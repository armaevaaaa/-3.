# Пункт 4 — «постучать по стене»: герой стучит по
# соляной стене и слушает эхо, пытаясь понять,
# есть ли рядом пустоты. Пока выводит только
# сообщение — обрабатывать будем дальше.
#
# Пункт 5 — «попробовать соль на вкус»: герой
# лизнул соляную стену. Это отнимает здоровье
# (слишком много соли вредно), но ничего не даёт.
# ================================================

# --- Заголовок ------------------------------------
title = "СОЛЯНЫЕ ШАХТЫ"
frame = "=" * 19
print(frame)
print(f"   {title}   ")
print(frame)
print()

# --- Знакомство с героем --------------------------
print("Как зовут героя?")
hero_name = input()
print(f"Добро пожаловать, {hero_name}!")
print("Ты входишь в соляные шахты. Стены покрыты белыми кристаллами, воздух сухой и колючий.")
print()

# --- Настройка героя ------------------------------
print("Настройка героя.")
print("Здоровье, сила, ловкость, выносливость - по одному числу в строке:")
health = int(input())
strength = int(input())
agility = int(input())
endurance = int(input())
print()

# --- Расчёт характеристик -------------------------
damage = 10 + strength * 1.5
crit_damage = damage * 2
stamina = (health + endurance * 3) // 10

# --- Формуляр героя --------------------------------
print("Характеристики героя:")
print(f"Здоровье:   {health}")
print(f"Сила:       {strength}")
print(f"Ловкость:   {agility}")
print(f"Выносливость: {endurance}")
print(f"Урон героя: {damage:.1f}")
print(f"Критический урон: {crit_damage:.1f}")
print(f"Запас сил:  {stamina}")
print()

# --- Меню действий --------------------------------
print("Что делаешь?")
print("1 - осмотреться")
print("2 - идти вперёд")
print("3 - отдохнуть")
print("4 - постучать по стене")
print("5 - попробовать соль на вкус")
print()

# --- Выбор действия --------------------------------
choice = input()
match choice:
    case "1":
        print("Ты осмотрелся. Стены мерцают белыми кристаллами, на полу - следы старых тележек.")

    case "2":
        stamina -= 2
        print("Ты идёшь вперёд по соляному туннелю. Хруст под ногами эхом разносится по шахте.")

    case "3":
        stamina += 1
        print("Ты прислонился к соляной стене и отдохнул. Прохлада бодрит.")

    case "4":
        print("Ты стучишь по стене. Глухое эхо уходит вглубь - где-то рядом пустота.")

    case "5":
        health -= 3
        print("Ты лизнул соляную стену. Соль обжигает язык - зря ты это сделал.")

    case _:
        print("Такого действия нет.")

# --- Состояние героя -------------------------------
print()
print(f"Здоровье: {health:5d}   Запас сил: {stamina:5d}")

# --- Прощание --------------------------------------
print()
print(frame)
print(f"Удачи, {hero_name}!")
print(frame)
